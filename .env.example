# Any OpenAI-compatible vision endpoint. Providers are numbered groups and are tried
# in order, so a rate limit on one does not stop a run. Rate limits apply per model
# AND per account, so the chain fails over across both.
#
# The last tier is local OCR (src/ocr.py). It needs no account and no key, so the
# automation still runs with none of the below filled in -- slower, and without the
# model's help on table structure, but it runs.

# ---- 1) Google Gemini, free tier ----------------------------------------------
# Key: https://aistudio.google.com/apikey  (free tier, no card required)
#
# Benchmarked on a real Fakturama grid: every flash model read it correctly, so
# capability was not the differentiator here -- these are crisp rendered tables.
# Speed was, and the lite models are ~9x faster for identical output:
#   gemini-3.5-flash-lite      994 ms   correct   <-- default
#   gemini-flash-lite-latest  1169 ms   correct
#   gemini-3.8-flash          3324 ms   correct
#   gemini-3.5-flash          8971 ms   correct
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash
LLM_API_KEY=REPLACE_ME

# ---- 2) OpenRouter, free tier (~50 requests/day per account) -------------------
# Key: https://openrouter.ai/keys  (free account, no payment method required)
LLM_BASE_URL_2=https://openrouter.ai/api/v1
LLM_API_KEY_2=sk-or-v1-REPLACE_ME
LLM_MODELS_2=inclusionai/ling-3.0-flash-vl:free,nex-agi/nex-n2.5-pro:free,dots-studio/dots-3-note-preview:free

# ---- 3) a second account of either, for a third bucket ------------------------
# LLM_BASE_URL_3=https://openrouter.ai/api/v1
# LLM_API_KEY_3=sk-or-v1-REPLACE_ME
# LLM_MODELS_3=inclusionai/ling-3.0-flash-vl:free

# ---- 4) local OCR -- no configuration, always the final fallback ---------------

# Some gateways sit behind Cloudflare and reject urllib's default User-Agent.
LLM_USER_AGENT=Mozilla/5.0
