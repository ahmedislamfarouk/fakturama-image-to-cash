# Any OpenAI-compatible vision endpoint. Default below is free and needs no card.
#
# 1) OpenRouter free tier  <-- default. Free account, no payment method required.
#    Key: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=inclusionai/ling-3.0-flash-vl:free
LLM_API_KEY=sk-or-v1-REPLACE_ME

# 2) opencode Zen (paid, needs workspace balance)
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=deepseek-v4-flash-vision-exp

# 3) Google Gemini via its OpenAI compatibility layer (paid, prepay balance)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest

# Some gateways sit behind Cloudflare and reject urllib's default User-Agent.
LLM_USER_AGENT=Mozilla/5.0
